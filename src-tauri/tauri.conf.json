{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Pomody",
	"version": "../package.json",
	"identifier": "com.pomody.app",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Pomody",
				"width": 800,
				"height": 650,
				"minWidth": 480,
				"minHeight": 500,
				"resizable": true,
				"decorations": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	}
}
